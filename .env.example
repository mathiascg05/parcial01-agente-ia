# Copie este archivo como .env y complete los valores. NO suba .env al repositorio.

# --- Data Mart (PostgreSQL) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=parcial01
# Rol de SOLO LECTURA que usa el agente (lo crea sql/Datamart.sql)
PG_USER=agente_lector
PG_PASSWORD=defina_una_clave_local
# Usuario administrador: sólo para crear/cargar el Data Mart (scripts/setup_datamart.py)
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=su_clave_de_postgres

# --- LLM vía OpenRouter (opcional: sin clave el agente usa el intérprete por reglas) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=25
# auto = LLM con respaldo por reglas | llm = sólo LLM | reglas = sin LLM
MODO_INTERPRETE=auto

# --- BDOO (ZODB) ---
# ZODB_PATH=data/bdoo/agente.fs
# ZODB_BLOBS=data/bdoo/blobs
